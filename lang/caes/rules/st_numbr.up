    call ZZtest_string_s_1_1_ZZstring134
    if answer is 0
      call ZZlprp_load__insert_2pt_s_1_4 addr left addr right sym cat_num_onze
      if answer is 0
        go to t_said
      end
    end
  end
  backtrack
place t2
  plant test t3
  call ZZlpta_load__setscan_l__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring135
    if answer is 0
      call ZZlprp_load__insert_2pt_s_1_5 addr left addr right sym cat_num_dotze
      if answer is 0
        go to t_said
      end
    end
  end
  backtrack
place t3
