  call ZZlpta_load__setscan_l__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring136
    if answer is 0
      call ZZlprp_load__insert_2pt_s_1_6 addr left addr right sym cat_num_tretze
      if answer is 0
        go to t_said
