      end
    end
  end
  backtrack
place v6
  plant test v7
  call ZZlpta_load__setscan_r__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring139
    if answer is 0
      call ZZlprp_load__insert_2pt_s_1_9 addr left addr right sym cat_num_vintisis
      if answer is 0
        go to v_said
      end
    end
  end
  backtrack
place v7
  plant test v8
  call ZZlpta_load__setscan_r__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring141
    if answer is 0
      call ZZlprp_load__insert_2pt_s_1_9 addr left addr right sym cat_num_vintiset
      if answer is 0
        go to v_said
      end
    end
