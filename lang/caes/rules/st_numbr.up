  if answer is 0
    call ZZtest_string_s_1_1_ZZstring137
    if answer is 0
      call ZZlprp_load__insert_2pt_s_1_7 addr left addr right sym cat_num_catorze
      if answer is 0
        go to t_said
      end
    end
  end
  backtrack
place t5
  plant test t6
  call ZZlpta_load__setscan_l__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring138
    if answer is 0
      call ZZlprp_load__insert_2pt_s_1_6 addr left addr right sym cat_num_quinze
      if answer is 0
        go to t_said
      end
    end
  end
  backtrack
place t6
  plant test t7
  call ZZlpta_load__setscan_l__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring139
    if answer is 0
      call ZZlprp_load__insert_2pt_s_1_5 addr left addr right sym cat_num_setze
      if answer is 0
        go to t_said
      end
    end
  end
  backtrack
place t7
  plant test t8
  call ZZlpta_load__setscan_l__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring141
    if answer is 0
      call ZZlprp_load__insert_2pt_s_1_6 addr left addr right sym cat_num_disset
      if answer is 0
        go to t_said
      end
    end
  end
  backtrack
place t8
  plant test t9
  call ZZlpta_load__setscan_l__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring142
    if answer is 0
      call ZZlprp_load__insert_2pt_s_1_6 addr left addr right sym cat_num_divuit
      if answer is 0
        go to t_said
      end
    end
  end
  backtrack
place t9
  plant test t_other
  call ZZlpta_load__setscan_l__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring143
    if answer is 0
      call ZZlprp_load__insert_2pt_s_1_5 addr left addr right sym cat_num_dinou
      if answer is 0
