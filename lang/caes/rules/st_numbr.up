# Twenty to twenty-nine. Like the teens, the rule is handed the number with
# the twenty already read and each arm tests the second digit, reading
# rightwards from the right-hand end, which is where this rule's bounds put
# it -- the teens rule wants the other direction, and only trying says which. The whole word goes in at once, spaces
# and all, because Catalan writes the joiner here.
rule convert_span_twenties takes 3 from st_numbr.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfence_null
  plant test v1
  call ZZlpta_load__setscan_r__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring132
    if answer is 0
      call ZZlprp_load__insert_2pt_s_1_4 addr left addr right sym cat_num_vint
      if answer is 0
        go to v_said
      end
    end
  end
