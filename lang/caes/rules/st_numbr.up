  end
  backtrack
place v5
  plant test v6
  call ZZlpta_load__setscan_r__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring138
    if answer is 0
      call ZZlprp_load__insert_2pt_s_1_9 addr left addr right sym cat_num_vinticinc
      if answer is 0
