# Catalan devoices a stop at the end of a word, and Castilian does not: fred
# is [f r e t], verd [b e r t], club [k l u p]. Spanish softens the same three
# letters into approximants instead, so every one of those words ended in a
# sound Catalan does not have there.
#
# What says the word has ended is two things together, because neither alone
# is enough: the scan may fail, and it may equally well succeed onto a space
# or a full stop. So the test is that the scan fails, or that what it lands on
# is not a letter. Anywhere else the letter says what it always said, and the
# lenition that follows is free to soften it.
rule apply_span_b_rules takes 3 from st_phone.obj
  local left bytes 8
  local right bytes 8
  local next bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfenceZZstring109
  # A b that a word ends on after an m is not said at all: amb is [@ m], tomb
  # [t o m], romb [r o m]. Castilian has no word ending in mb and Catalan's
  # rule is not the devoicing below it -- the b does not become a p, it goes.
  # Except in front of a vowel, where it comes back and is a b: amb ell is
  # [@ m b e L] and amb mi is [@ m m i], which is what em mi sounds like and
  # is the whole of the test a listener applies to it.
  # The b is said as an m, which is what Catalan says: amb mi is [@ m m i],
  # two m's running together, and that is the sound a listener asked for when
  # they said it should be em mi.
  #
  # It is not the mute phone the lost r uses, and the difference is audible.
  # The mute is a segment that lays down no formants and no voice, so what
  # comes out is a silence of its own length -- and between the m of amb and
  # the m of mi a silence is a stop closure, which is exactly the b that was
  # still being heard. Measured, amb mi had fifty milliseconds of near-silence
  # in the middle where em mi has none, and shortening the mute to nothing did
  # not close it.
  #
  # Nor is it nothing at all, which was tried and crashes: a letter rule that
  # lays no phone down leaves an empty span behind it, and amb or tomb said on
  # its own with nothing after it takes the engine down with a segmentation
  # fault. A real phone is what the rule owes its caller.
  #
  # -ble is said -ple. Catalan geminates the stop of a final -ble and what
  # comes out is voiceless: poble is [p O p l @], doble [d o p l @], estable
  # [@ s t a p l @], noble, amable, possible. Asking for the whole ending is
  # what keeps blau, oblidar and problema out of it, none of which ends there.
  plant test amb
  call ZZlpta_load__setscan_r__1 addr right
  if answer is 0
    call test_string_s 1 1 sym cat_letter_l
    if answer is 0
      call test_string_s 1 1 sym cat_letter_e
      if answer is 0
        call cat_after_one_more                        # poble, and pobles
        if answer is 0
          call ZZlprp_load__insert_2pt_s_4_1_ZZstring5 addr left addr right  # p
          if answer is 0
            go to said
          end
        end
      end
    end
  end
  backtrack
place amb
  plant test amb_m
  call cat_word_end addr right
  if answer is 0
    call ZZlpta_load__setscan_l__1 addr left
    if answer is 0
      call test_string_s 1 1 sym cat_letter_m
      if answer is 0
        call cat_insert_m addr left addr right
        if answer is 0
          go to said
        end
      end
    end
  end
  backtrack
place amb_m
  # A next word that does not begin with a vowel: the b says nothing at all.
  #
  # Nothing, and not the mute phone the lost r uses. The mute is a segment
  # that lays down no formants and no voice, so what comes out is a silence of
  # its own length, and between the m of amb and the m of mi a silence is a
  # stop closure -- which is exactly the b that could still be heard. amb mi
  # and em mi are the same wave to the byte now, which is the test that was
  # asked for.
  plant test amb_end
  call cat_word_end addr right
  if answer is 0
    call ZZlpta_load__setscan_l__1 addr left
    if answer is 0
      call test_string_s 1 1 sym cat_letter_m
      if answer is 0
        call ZZlpta_load__setscan_r__1 addr right
        if answer is 0
          call cat_step_over_boundary
          if answer is 0
            call ZZsavescptr2 addr next
            call ZZlpta_load__setscan_r__1 addr next
            if answer is 0
              call cat_next_word_vowel
              if answer is 0
                call ZZlprp_load__insert_2pt_s_4_1_ZZstring121 addr left addr right  # b
                if answer is 0
                  go to said
                end
              end
            end
            go to said
          end
        end
      end
    end
  end
  backtrack
place amb_end
  # And where nothing follows at all, an m, because nothing will not do there:
  # a letter rule that lays no phone down leaves an empty span, and amb, tomb,
  # amb. and hola amb all took the engine down with a segmentation fault while
  # amb mi was fine. tomb said on its own is [t o m], so the m is what the
  # word wants anyway.
  plant test devoice
  call cat_word_end addr right
  if answer is 0
    call ZZlpta_load__setscan_l__1 addr left
    if answer is 0
      call test_string_s 1 1 sym cat_letter_m
      if answer is 0
        call cat_insert_m addr left addr right
        if answer is 0
          go to said
        end
      end
    end
  end
  backtrack
place devoice
  plant test plain
  call ZZlpta_load__setscan_r__1 addr right
  if answer is 0
    call ZZtestFldeq1_3_1                                              # a letter?
    if answer is 0
      call cat_voiceless_follows                                       # a voiceless one?
      if answer is not 0
        backtrack
      end
    end
  end
  call ZZlprp_load__insert_2pt_s_4_1_ZZstring5 addr left addr right     # p
  if answer is not 0
    backtrack
  end
  go to said
place plain
  call ZZlprp_load__insert_2pt_s_4_1_ZZstring121 addr left addr right   # b
  if answer is not 0
    backtrack
  end
place said
  call succeed
  put cell right value into arg 2 at 4
  answer 0
end

rule apply_span_d_rules takes 3 from st_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfenceZZstring109
  plant test plain
