# ---- r, and the one Catalan does not say --------------------------------

# Castilian's three arms are kept as they are: rr is the trill, so is an r at
# the start of a word and one after l, n or s, and everywhere else it is the
# tap. What is new is the arm in front of them, which is the whole of the
# difference between cagar and caga` -- an r at the end of a word goes when
# the word has a second vowel in it.
#
# glob.up says why it becomes a phone rather than becoming nothing, and what
# the test in front of it asks. The order matters: the drop is asked about
# first, because an r at the end of a word would otherwise be taken by the
# arm for the tap and never reach this.
rule apply_span_r_rules takes 3 from st_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfenceZZstring109
  plant test mono
  call cat_word_end addr right
  if answer is 0
    call ZZlpta_load__setscan_l__1 addr left
    if answer is 0
      call ZZtestFldeq1_4_1                                # a vowel before it?
      if answer is 0
        call advance_tok                                   # step on to it
        if answer is 0
          call cat_more_vowels_left                        # and another behind?
          if answer is 0
            call cat_insert_mute addr left addr right
            if answer is 0
              go to said
            end
          end
        end
      end
    end
  end
  backtrack
place mono
  # fer, dir and ser, which have one vowel each and so are invisible to the
  # walk above. glob.up says why they are written down as words rather than
  # reached by loosening it.
  plant test rr
  call cat_word_end addr right
  if answer is 0
    call ZZlpta_load__setscan_l__1 addr left
    if answer is 0
      call cat_mono_infinitive
      if answer is 0
        call cat_insert_mute addr left addr right
        if answer is 0
          go to said
        end
      end
    end
  end
  backtrack
place rr
  plant test word_start
  call ZZlpta_load__setscan_r__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring94                    # another r?
    if answer is 0
      call ZZsavescptr2 addr right
      call ZZlprp_load__insert_2pt_s_4_1_ZZstring106 addr left addr right  # R
      if answer is 0
        go to said
      end
    end
  end
  backtrack
place word_start
  # An r that begins a word is the trill: roig, riu, ra'pid. Castilian asks
  # this by holding the left-hand end against the pointer the word began at,
  # which is a state variable and so is an address the upper notation cannot
  # name. What stands before the first letter of a word is not a letter, and
  # that is the same question asked of the letters themselves.
  plant test after_lns
  call ZZlpta_load__setscan_l__1 addr left
  if answer is not 0
    call ZZlprp_load__insert_2pt_s_4_1_ZZstring106 addr left addr right  # R
    if answer is 0
      go to said
    end
  end
  call ZZtestFldeq1_3_1                                  # a letter before it?
  if answer is not 0
    call ZZlprp_load__insert_2pt_s_4_1_ZZstring106 addr left addr right  # R
    if answer is 0
      go to said
    end
  end
  backtrack
place after_lns
  plant test tap
  call ZZlpta_load__setscan_l__1 addr left
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring96                    # s before it?
    if answer is 0
      call ZZlprp_load__insert_2pt_s_4_1_ZZstring106 addr left addr right  # R
      if answer is 0
        go to said
      end
    end
    call ZZtest_string_s_1_1_ZZstring69                    # or l?
    if answer is 0
      call ZZlprp_load__insert_2pt_s_4_1_ZZstring106 addr left addr right  # R
      if answer is 0
        go to said
      end
    end
    call ZZtest_string_s_1_1_ZZstring84                    # or n?
    if answer is 0
      call ZZlprp_load__insert_2pt_s_4_1_ZZstring106 addr left addr right  # R
      if answer is 0
        go to said
      end
    end
  end
  backtrack
place tap
  call ZZlprp_load__insert_2pt_s_4_1_ZZstring104 addr left addr right   # r
  if answer is not 0
    backtrack
  end
place said
  call succeed
  put cell right value into arg 2 at 4
  answer 0
end

# qu says k before e and i, and the u is not there. Castilian's rule asks
# about four letters -- e, i and the two of them with an acute -- and Catalan
# writes a fifth: que` and perque` carry the grave, which caes.codepoints
# deliberately does not flatten because it is the open vowel. Without it here
# the u was read as the glide it is in quatre, and perque` came out
# [p @ r k w E].
rule apply_span_q_rules takes 3 from st_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfenceZZstring109
  plant test said
  call ZZlpta_load__setscan_r__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring128                   # a u after the q?
    if answer is 0
      call ZZsavescptr2 addr right                         # then it says nothing
      call ZZtest_string_s_1_1_ZZstring77                  # e?
      if answer is 0
        go to said
      end
      call test_string_s 1 1 sym cat_letter_egrave         # e with a grave?
      if answer is 0
        go to said
      end
      call ZZtest_string_s_1_1_ZZstring12                  # e with an acute?
      if answer is 0
        go to said
      end
      call ZZtest_string_s_1_1_ZZstring109                 # i?
      if answer is 0
        go to said
      end
      call ZZtest_string_s_1_1_ZZstring13                  # i with an acute?
      if answer is 0
        go to said
      end
    end
  end
  backtrack
place said
  call ZZlprp_load__insert_2pt_s_4_1_ZZstring109 addr left addr right   # k
  if answer is not 0
    backtrack
  end
  call succeed
  put cell right value into arg 2 at 4
  answer 0
end
