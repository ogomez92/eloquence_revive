# a, e and o say one thing each and take nothing with them.
#
# Castilian's rules for these are long because they are where its diphthongs
# are decided: an a followed by an i eats the i and lays down the glide
# itself. Catalan decides the same thing from the other end -- an i or a u is
# a glide when a vowel stands before it, which is what the two rules above
# say -- and having both is worse than having either. It is why ix could not
# work: the i of caixa never reached its own rule to eat the x, because the a
# had already taken it.
#
# So these three lay down their vowel and leave the scan where it was. The
# accented forms come through the same rules and say the same vowel, which is
# right for Catalan: a with an acute is the same [a], and the graves are the
# open pair and go elsewhere.
rule apply_span_a_rules takes 3 from st_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfenceZZstring109
  call ZZlprp_load__insert_2pt_s_4_1_ZZstring115 addr left addr right   # a
  if answer is not 0
    give up
  end
  call succeed
  put cell right value into arg 2 at 4
  answer 0
end

# The e is the same two vowels the o is, and the writing says even less about
# it: the grammars' own lists for the unaccented stressed e are endings that
# contradict each other -- setze is open and tretze is close and they rhyme.
# So there is one arm and it is one word, which is the honest description of
# it. It is here because the number is: sixteen said with a close e is the
# vowel of tretze, and a listener asked for it.
rule apply_span_e_rules takes 3 from st_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfenceZZstring109
  plant test set
  call ZZlpta_load__setscan_r__1 addr right
  if answer is 0
    call test_string_s 1 1 sym cat_letter_t
    if answer is 0
      call test_string_s 1 1 sym cat_letter_z
      if answer is 0
        call ZZlpta_load__setscan_l__1 addr left
        if answer is 0
          call test_string_s 1 1 sym cat_letter_s
          if answer is 0
            call cat_word_starts
            if answer is 0
              call cat_insert_eopen addr left addr right
              if answer is 0
                go to said
              end
            end
          end
        end
      end
    end
  end
  backtrack
place set
  # set, the number, which is open where fet and gest are close. Another word
  # asked about by its own letters; the digit is spelt with the grave in
  # rules/constants and this is the word typed out.
  plant test ple
  call ZZlpta_load__setscan_r__1 addr right
  if answer is 0
    call test_string_s 1 1 sym cat_letter_t
    if answer is 0
      call cat_after_one_more
      if answer is 0
        call ZZlpta_load__setscan_l__1 addr left
        if answer is 0
          call test_string_s 1 1 sym cat_letter_s
          if answer is 0
            call cat_word_starts
            if answer is 0
              call cat_insert_eopen addr left addr right
              if answer is 0
                go to said
              end
            end
          end
        end
      end
    end
  end
  backtrack

place ple
  # A word of one syllable that ends on its e: ple, fe, re.
  #
  # Which of them are open cannot be read off the letter, because the acute is
  # flattened on the way in -- caes.codepoints keeps the grave and not the
  # acute -- so be, te, se and ve arrive looking exactly like fe and re. So it
  # is asked the other way round: glob.up holds the letters that keep it
  # close, and everything else is open. The same shape the eu diphthong uses
  # for meu, teu and seu.
  plant test eix
  call cat_word_end addr right
  if answer is 0
    call ZZlpta_load__setscan_l__1 addr left
    if answer is 0
      call cat_close_final_e_head
      if answer is not 0
        call cat_more_vowels_left
        if answer is not 0
          call cat_insert_eopen addr left addr right
          if answer is 0
            go to said
          end
        end
      end
    end
  end
  backtrack

place eix
  # -eix is open where the word has another vowel in it and close where it has
  # not. It is the one shape here that splits on the length of the word rather
  # than on its letters: eix, peix, feix and neix are close, and llegeix,
  # coneix and farceix -- the inchoative verbs, which is where most of the
  # language's -eix words are -- are open.
  #
  # Asking whether a second vowel stands to the left is what the r rule asks
  # to tell passar from clar, and cat_more_vowels_left is its walk. deixar and
  # coneixement reach this too and cost nothing either way, their e being
  # unstressed and so a schwa by the time it is spoken.
  plant test ema
  call ZZlpta_load__setscan_r__1 addr right
