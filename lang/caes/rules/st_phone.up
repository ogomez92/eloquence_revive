          call cat_open_on_head
          if answer is 0
            call cat_insert_oopen addr left addr right
            if answer is 0
              go to said
            end
          end
        end
      end
    end
  end
  backtrack
place close
  call ZZlprp_load__insert_2pt_s_4_1_ZZstring116 addr left addr right   # o
  if answer is not 0
    backtrack
  end
place said
  call succeed
  put cell right value into arg 2 at 4
