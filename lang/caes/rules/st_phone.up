      if answer is 0
        call cat_insert_oopen addr left addr right
        if answer is 0
          go to said
        end
      end
    end
  end
  backtrack
place before_nj
  # An o before an n and a soft g or j: taronja, taronges, monja, esponja,
  # llonja. The two spellings are one sound and the plural is where the g
  # turns up, so both letters are asked about.
  plant test before_bl
  call ZZlpta_load__setscan_r__1 addr right
  if answer is 0
    call test_string_s 1 1 sym cat_letter_n
    if answer is 0
      call cat_soft_gj
      if answer is 0
        call cat_insert_oopen addr left addr right
        if answer is 0
          go to said
        end
      end
    end
  end
  backtrack
place before_bl
  # An o before bl, which is poble and noble -- and doble, which is the close
  # one and is taken out by asking what stands in front of the o. Three words
  # is not a rule and this does not pretend to be one; it is here because the
  # first two are common and there is no dictionary to put them in.
  plant test bon
  call ZZlpta_load__setscan_r__1 addr right
  if answer is 0
    call test_string_s 1 1 sym cat_letter_b
    if answer is 0
      call test_string_s 1 1 sym cat_letter_l
      if answer is 0
        call ZZlpta_load__setscan_l__1 addr left
        if answer is 0
          call test_string_s 1 1 sym cat_letter_d          # doble stays close
          if answer is not 0
