  plant test before_sa
  call cat_open_o_word addr left addr right
  if answer is 0
    call cat_insert_oopen addr left addr right
    if answer is 0
      go to said
    end
  end
  backtrack
place before_sa
  # An o before a single s that the stem ends in a vowel after: rosa, roses,
  # cosa, coses, esposa, famosa, preciosa, posa. It is the alternation the
  # language turns on -- famos is close and famosa is open -- and the two
  # things it must not take are exactly the two the test keeps out. A bare -os
  # is close, which is cos, gos, os, dos, tros and mos, so the stem has to end
  # in a vowel. And a doubled s is close, which is gossa, rossa, bossa and
  # grossa; those need nothing of their own, since the letter after the o is
  # an s and the letter after that is another, and a stem does not end there.
  plant test before_nj
  call ZZlpta_load__setscan_r__1 addr right
