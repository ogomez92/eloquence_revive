# A grave is the open vowel and always carries the stress. Which of the two it
# is has to be asked here, because one arm serves both.
rule apply_span_enye_rules takes 3 from st_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfenceZZstring109
