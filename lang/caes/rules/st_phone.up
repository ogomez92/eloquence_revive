      call ZZtestFldeq1_3_1
      if answer is not 0
        call ZZlpta_load__setscan_l__1 addr left
        if answer is 0
          call test_string_s 1 1 sym cat_letter_r
          if answer is 0
            call cat_insert_eopen addr left addr right
            if answer is 0
              go to said
            end
          end
        end
      end
    end
  end
  backtrack

place eu
  # The eu diphthong, which is open: deu, peu, neu, creu, beu, veu, preu, and
  # every second person plural the language has -- canteu, beveu, veieu. The
  # three that are close are meu, teu and seu, and glob.up says how they are
  # told from canteu. The o's diphthong arm is the same shape and needs no
  # such list, ou and oi being open wherever they fall.
  plant test tren
  call ZZlpta_load__setscan_r__1 addr right
