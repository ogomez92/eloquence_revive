      call test_string_s 1 1 sym cat_letter_x
      if answer is 0
        call ZZlpta_load__setscan_l__1 addr left
        if answer is 0
          call cat_more_vowels_left
          if answer is 0
            call cat_insert_eopen addr left addr right
            if answer is 0
              go to said
            end
          end
        end
      end
    end
  end
  backtrack

place ema
  # -ema is open: problema, sistema, tema, poema, esquema, crema. The stem has
  # to end in a vowel after the m, which takes problemes with it and keeps
  # every other word with an em in it out.
  plant test tres
  call ZZlpta_load__setscan_r__1 addr right
  if answer is 0
    call test_string_s 1 1 sym cat_letter_m
    if answer is 0
      call cat_stem_ends_vowel
      if answer is 0
        call cat_insert_eopen addr left addr right
        if answer is 0
          go to said
        end
      end
    end
  end
  backtrack
place tres
  # tres, res and gres: an e the word ends on after an s, with an r in front
  # of it. mes and pes are close and have no r, and every plural of a word in
  # -re -- pares, llibres, sobres -- has the e unstressed, where an open e is
  # a schwa by the time it is spoken and costs nothing.
